# Django settings
DJANGO_SECRET_KEY=replace-with-a-long-random-secret-before-deployment
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Database: use "postgresql" when PostgreSQL is available, otherwise "sqlite"
DB_ENGINE=postgresql
DB_NAME=inventory_management
DB_USER=inventory_user
DB_PASSWORD=change-this-local-password
DB_HOST=localhost
DB_PORT=5432
